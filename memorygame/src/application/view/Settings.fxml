<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.effect.*?>
<?import javafx.geometry.Insets?>

<StackPane fx:id="settingsRoot" 
           fx:controller="application.controller.SettingsController" 
           prefWidth="450" prefHeight="600" 
           xmlns="http://javafx.com/javafx/8" 
           xmlns:fx="http://javafx.com/fxml/1">
   
   <VBox style="-fx-background-color: #1a120b; -fx-border-color: #d4a373; -fx-border-width: 2; -fx-border-radius: 10; -fx-background-radius: 10;">
      <children>
         <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="15.0" style="-fx-background-color: rgba(212, 163, 115, 0.1);">
            <padding><Insets left="20" right="20"/></padding>
            <children>
               <Rectangle width="15" height="15" fill="#faedcd" rotate="45">
                  <effect><Glow level="0.8"/></effect>
               </Rectangle>
               <Label text="BRAIN POWER SETUP" 
                      style="-fx-text-fill: #faedcd; -fx-font-size: 22; -fx-font-weight: 900; -fx-letter-spacing: 1;">
                  <effect><DropShadow color="BLACK" radius="5" offsetY="2" /></effect>
               </Label>
            </children>
         </HBox>

         <VBox spacing="20.0" alignment="TOP_CENTER">
            <padding><Insets top="30" left="30" right="30"/></padding>
            <children>
               
             <VBox spacing="5" style="-fx-border-color: #d4a373; -fx-border-width: 0 0 0 4; -fx-padding: 10;">
    <Label text="GAME HERO NAME" style="-fx-text-fill: #997b66; -fx-font-size: 11; -fx-font-weight: bold;"/>
    
    <Label fx:id="pilotNameDisplay" text="???" style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;"/>
</VBox>

               <GridPane vgap="15" hgap="15">
   <children>
      <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" prefWidth="180" 
            style="-fx-background-color: #281c12; -fx-padding: 15; -fx-background-radius: 10; -fx-border-color: rgba(212, 163, 115, 0.2); -fx-border-width: 1;">
         <Label text="BRAIN POWER" style="-fx-text-fill: #d4a373; -fx-font-size: 11; -fx-font-weight: bold;"/>
         <Label fx:id="difficultyValue" text="SUPER SMART" style="-fx-text-fill: #faedcd; -fx-font-size: 18; -fx-font-weight: 900;"/>
      </VBox>

      <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="180" 
            style="-fx-background-color: #281c12; -fx-padding: 15; -fx-background-radius: 10; -fx-border-color: rgba(46, 204, 113, 0.2); -fx-border-width: 1;">
         <Label text="GAME STATUS" style="-fx-text-fill: #d4a373; -fx-font-size: 11; -fx-font-weight: bold;"/>
         <Label text="READY TO PLAY!" style="-fx-text-fill: #2ecc71; -fx-font-size: 18; -fx-font-weight: 900;"/>
      </VBox>
   </children>
</GridPane>
              <StackPane prefHeight="150" style="-fx-background-color: #0d0d1a; -fx-border-color: #6c5ce7; -fx-border-radius: 15; -fx-background-radius: 15; -fx-border-width: 2;">
   <children>
      <VBox alignment="CENTER" opacity="0.1">
         <children>
            <Label text="+ + + + + + + + + +" style="-fx-text-fill: white; -fx-font-size: 8;"/>
            <Label text="+ + + + + + + + + +" style="-fx-text-fill: white; -fx-font-size: 8;"/>
            <Label text="+ + + + + + + + + +" style="-fx-text-fill: white; -fx-font-size: 8;"/>
         </children>
      </VBox>

      <VBox alignment="CENTER" spacing="10">
         <children>
            <Label text="🧠 BRAIN SCAN IN PROGRESS..." 
                   style="-fx-text-fill: #a29bfe; -fx-font-family: 'Monospaced'; -fx-font-weight: bold; -fx-font-size: 14;">
               <effect>
                  <Glow level="0.8"/>
               </effect>
            </Label>
            
            <HBox alignment="CENTER" spacing="5">
               <children>
                  <Rectangle width="40" height="10" fill="#6c5ce7" arcWidth="5" arcHeight="5"/>
                  <Rectangle width="40" height="10" fill="#6c5ce7" arcWidth="5" arcHeight="5"/>
                  <Rectangle width="40" height="10" fill="#6c5ce7" arcWidth="5" arcHeight="5"/>
                  <Rectangle width="40" height="10" fill="#341f97" arcWidth="5" arcHeight="5" opacity="0.3"/>
                  <Rectangle width="40" height="10" fill="#341f97" arcWidth="5" arcHeight="5" opacity="0.3"/>
               </children>
            </HBox>
            
            <Label text="MEMORY STRENGTH: HIGH" style="-fx-text-fill: #00b894; -fx-font-size: 10; -fx-font-weight: bold;"/>
         </children>
      </VBox>
   </children>
</StackPane>

            </children>
         </VBox>

         <Region VBox.vgrow="ALWAYS"/>

         <VBox alignment="CENTER" spacing="10" style="-fx-padding: 30;">
            <Button onAction="#handleReturn" prefWidth="300" prefHeight="45" text="BACK TO STATION" 
                    style="-fx-background-color: transparent; -fx-border-color: #d4a373; -fx-text-fill: #d4a373; -fx-font-weight: bold; -fx-cursor: hand;"/>
         </VBox>
      </children>
   </VBox>
</StackPane>